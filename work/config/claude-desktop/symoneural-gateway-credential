#
# Credential helper for the reference third-party client.
#
# The client runs this as the desktop user and reads ONE line from stdout: either a
# bare token, or {"token": "...", "headers": {...}}. Anything else on stdout — a
# banner, a prompt, a log line — makes it reject the output with "Output has multiple
# lines". So this prints the token and nothing else; diagnostics go to stderr, which
# the client logs and ignores.
#
# WHY A HELPER AND NOT THE KEY IN THE CONFIG FILE
# -----------------------------------------------
# The alternative credential kind requires the key as a literal value inside
# /etc/claude-desktop/managed-settings.json, which must be world-readable for the
# client to accept it (it refuses a group- or world-writable file, and runs as the
# user, so root-only modes do not work). That would put a live credential in a
# world-readable system file. A helper keeps the secret in the user's own 0600 file
# and hands over only the value, on demand. When a helper is set the client ignores
# the static credential fields entirely.
#
# The environment variable CLAUDE_HELPER_CONTEXT arrives set to one of interactive,
# mid-session-refresh, background, scheduled-task or setup-test. It is not used here;
# the same credential serves every context.
set -u
KEY_FILE=${SYM_GW_KEY_FILE:-$HOME/.config/symoneural/gateway-9001.key}

if [ ! -r "$KEY_FILE" ]; then
  echo "symoneural-gateway-credential: cannot read $KEY_FILE" >&2
  exit 1
fi

# tr -d strips any trailing newline; the value must be one line with nothing after it.
tr -d '\r\n' < "$KEY_FILE"
