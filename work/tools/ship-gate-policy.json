    },
    "UNKNOWN": {
      "verdict": "FAIL",
      "ids": [
        "",
        "null",
        "None",
        "NOASSERTION",
        "NONE",
        "Unknown",
        "UNKNOWN",
        "LicenseRef-Unknown",
        "CLOSED",
        "OTHER",
