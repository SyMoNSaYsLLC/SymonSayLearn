        "Vim",
        "MIT-feh",
        "MITNFA",
        "ICU",
        "Plexus",
        "JSON-no-evil-removed"
      ],
      "note": "Fine to ship. Every component in this class MUST appear in THIRD-PARTY-NOTICES with name, version and licence; Apache-2.0 NOTICE files must be reproduced."
    },
    "WEAK_COPYLEFT_FILE": {
      "verdict": "PASS_IF_UNMODIFIED",
      "requires_attribution": true,
      "ids": [
        "MPL-2.0",
        "MPL-1.1",
        "CDDL-1.0",
        "CDDL-1.1",
        "EPL-1.0",
        "EPL-2.0",
        "CPL-1.0",
        "CECILL-C",
        "EUPL-1.1",
        "OSL-3.0-file"
      ],
      "note": "File-level copyleft. Passes only when the files are shipped unmodified; any modification of a covered file must be published under the same terms. EUPL and OSL are here only for file scope — their network clauses are handled in NETWORK_COPYLEFT when they govern a whole component."
    },
    "WEAK_COPYLEFT_LIB": {
      "verdict": "PASS_IF_DYNAMIC",
      "requires_attribution": true,
      "ids": [
        "LGPL-2.0-only",
        "LGPL-2.0-or-later",
        "LGPL-2.1-only",
        "LGPL-2.1-or-later",
        "LGPL-2.1",
        "LGPL-2.0"
      ],
      "note": "Passes only across a dynamic-link boundary (glibc, GStreamer core). FAILS when statically linked — which is every Rust closure and every static C archive. LGPL-3 is NOT here: the image policy INCOMPATIBLE_LICENSE excludes it and so does this gate."
    },
    "STRONG_COPYLEFT": {
      "verdict": "FAIL",
      "ids": [
        "GPL-1.0-only",
        "GPL-1.0-or-later",
        "GPL-2.0-only",
        "GPL-2.0-or-later",
        "GPL-3.0-only",
