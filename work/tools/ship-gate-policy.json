      "keywords": [
        "non-commercial",
        "noncommercial",
        "non commercial",
        "research purposes only",
        "research only",
        "evaluation only",
        "educational use only",
        "not for commercial",
        "competing",
        "competitive offering",
        "acceptable use policy",
        "monthly active users",
        "field of use",
        "shall not be used for",
        "may not be used to"
      ],
      "note": "We are a commercial product. Anything that restricts commercial use, competing use, field of use or acceptable use FAILS — including OTHER companies' source-available licences (their FSL/BSL/Elastic forbids exactly what we would be doing). Our own FSL-1.1-ALv2 on our own code is of course fine; the checker exempts first-party units by name."
    },
    "NUISANCE_CLAUSE": {
      "verdict": "FAIL",
      "ids": [
        "BSD-4-Clause",
        "BSD-4-Clause-UC",
        "BSD-4-Clause-Shortened",
        "BSD-4.3TAHOE",
        "BSD-4.3RENO",
