        "Sleepycat",
        "GFDL-1.1",
        "GFDL-1.2",
        "GFDL-1.3",
        "GFDL-1.3-only",
        "GFDL-1.3-or-later",
        "CC-BY-SA-4.0",
        "CC-BY-SA-3.0",
        "QPL-1.0"
      ],
      "exceptions_that_neutralise": [
        "GCC-exception-3.1",
        "GCC-exception-2.0",
        "Classpath-exception-2.0",
        "LLVM-exception",
        "Bison-exception-2.2",
        "Autoconf-exception-3.0",
