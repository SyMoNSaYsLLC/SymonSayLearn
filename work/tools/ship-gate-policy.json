{
  "schema": "symoneural-ship-gate/1",
  "decided": "2026-09-18",
  "decided_by": "Garrett McDonald — 'clean from all angles', not only copyleft",
  "product_licence": "FSL-1.1-ALv2",
  "product_is_commercial": true,
