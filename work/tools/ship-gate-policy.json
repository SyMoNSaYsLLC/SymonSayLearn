        "mif-exception",
        "Font-exception-2.0",
        "Linux-syscall-note",
        "OpenJDK-assembly-exception-1.0",
        "Qt-GPL-exception-1.0",
        "u-boot-exception-2.0",
        "Universal-FOSS-exception-1.0",
        "WxWindows-exception-3.1",
        "GPL-3.0-linking-exception",
        "GPL-3.0-linking-source-exception",
        "LGPL-3.0-linking-exception"
      ],
      "note": "Never in a shipped closure. 'X OR GPL' is fine (pick X); 'X AND GPL' is not. libgcc/libstdc++ pass only via the GCC Runtime Library Exception."
    },
    "NETWORK_COPYLEFT": {
      "verdict": "FAIL",
      "ids": [
