  "or_expression_rule": "take the least restrictive alternative",
  "and_expression_rule": "the most restrictive term governs",
  "static_link_rule": "in a statically linked closure (Rust binaries, .a archives, wheels with bundled .so) WEAK_COPYLEFT_LIB is treated as STRONG_COPYLEFT",
  "attribution_rule": "every shipped component in PERMISSIVE / WEAK_* must appear in THIRD-PARTY-NOTICES.md by name; absence FAILS the unit",
  "weights_rule": "no weights (.safetensors .gguf .pt .pth .ckpt .bin>100MB .npz .h5 .onnx>100MB) inside any artifact; named weights must be PERMISSIVE (Apache-2.0 / MIT). RAIL, Llama, Gemma, non-commercial weights FAIL even when only referenced by default config.",
  "trademark_rule": "third-party marks (openai, gpt, anthropic, claude, nvidia, geforce, meta, llama, google, gemma, mistral, huggingface, cloudflare) must not appear in artifact filenames, package names, image names or product-facing UI titles. Occurrences in UI body text, client-compatibility notes and dependency names are listed for REVIEW, not failed.",
  "secrets_rule": "any match of the secrets regex set in the CONTENT of any staged file, inside any archive, or in any blob of the git history to be pushed FAILS; any file whose PATH matches secret_file_paths FAILS. Mentioning where a key file lives (its path) is permitted — that is how the code documents the secret's location without carrying it.",
  "vulnerability_rule": "known CVEs of severity HIGH or CRITICAL in the shipped closure FAIL (pip-audit, pnpm audit --prod, cargo audit). An unavailable scanner is recorded as REVIEW, never as a pass.",
  "august_rule": "any input dated 2026-08 (mtime, pin date, tag date, log line) FAILS — it predates the fresh start",
  "first_party_units": [
    "symoneural-api",
    "symoneural-llm",
    "symoneural-learn",
    "symoneural-learn-web",
    "symoneural-learn-hostrun",
    "symoneural-api-native",
    "symoneural-llm-native",
    "symoneural-image-learn",
    "symoneural-image",
    "symoneural-streamer",
    "source"
  ],
  "exceptions": [
    {
      "component": "glibc",
      "licence": "LGPL-2.1-or-later AND GPL-2.0-or-later (tooling only)",
      "class": "WEAK_COPYLEFT_LIB",
      "why_it_passes": "the system C library, always dynamically linked; the GPL parts are build tooling that does not ship",
      "ruled_by": "Garrett McDonald, 2026-09-18 (image policy leaves LGPL-2.1 out of INCOMPATIBLE_LICENSE deliberately)"
    },
    {
      "component": "libgcc / libstdc++ / libgomp",
      "licence": "GPL-3.0-or-later WITH GCC-exception-3.1",
      "class": "STRONG_COPYLEFT",
      "why_it_passes": "GCC Runtime Library Exception 3.1 §1 permits linking into proprietary works",
      "ruled_by": "policy — exceptions_that_neutralise"
    }
  ],
  "secrets_patterns": {
