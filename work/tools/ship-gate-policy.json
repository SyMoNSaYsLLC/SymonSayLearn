    "openai_key": "sk-(proj-|live-|test-)?[A-Za-z0-9]{20,}",
    "github_token": "gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{60,}",
    "aws_access_key": "AKIA[0-9A-Z]{16}",
    "aws_secret": "(?i)aws(.{0,20})?(secret|private)(.{0,20})?['\\\"][0-9a-zA-Z/+]{40}['\\\"]",
    "google_api_key": "AIza[0-9A-Za-z_\\-]{35}",
    "slack_token": "xox[baprs]-[0-9A-Za-z\\-]{10,}",
    "cloudflare_token": "(?i)cloudflare(.{0,20})?token(.{0,20})?['\\\"][A-Za-z0-9_\\-]{40}['\\\"]",
    "hf_token": "hf_[A-Za-z0-9]{30,}",
    "private_key_block": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY( BLOCK)?-----",
    "jwt": "eyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}",
    "generic_assignment": "(?i)(api[_-]?key|secret|token|passwd|password)\\s*[=:]\\s*['\\\"][A-Za-z0-9_\\-/+]{24,}['\\\"]"
  },
